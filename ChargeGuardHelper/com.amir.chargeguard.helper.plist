<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist for SMAppService.daemon(plistName: "com.amir.chargeguard.helper.plist").
  Copied into ChargeGuard.app/Contents/Library/LaunchDaemons/ by the app target's build phase.
  BundleProgram is relative to the app bundle. The fallback installer (scripts/install-helper.sh)
  writes its own plist with ProgramArguments instead.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.amir.chargeguard.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/ChargeGuardHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.amir.chargeguard.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.amir.chargeguard</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Adaptive</string>
</dict>
</plist>
